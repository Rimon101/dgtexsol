# Environment Variables Template
# Copy this file to .env.local and fill in your Supabase credentials.
# NEVER commit .env.local to version control.

# Supabase — Public API Credentials (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase — Server-only Secret Key (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Canonical Site URL (Optional for localhost, required for production SEO & sitemaps)
NEXT_PUBLIC_SITE_URL=https://yourstore.com

# Waitmark Pay — Payment Gateway (Server-only, NEVER prefix with NEXT_PUBLIC_)
WAITMARK_PUBLIC_KEY=pk_live_xxxx
WAITMARK_SECRET_KEY=sk_live_xxxx
